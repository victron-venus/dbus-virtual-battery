{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "calculator",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_calculator.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/calculator",
      "instrumentation": [
        {
          "module": "dbus-virtual-battery",
          "functions": [
            "calculate_virtual_battery",
            "_chain_totals"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "dbus-virtual-battery.py",
    "fuzz",
    "pyproject.toml",
    "requirements.txt",
    "uv.lock"
  ]
}
