#!/bin/bash

# dbus-virtual-battery SetupHelper compatible setup script
# Virtual Battery Calculator for Victron Venus OS

#### following line incorporates SetupHelper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

# Default configuration
defaultSmartshuntIndex="0"          # Index of SmartShunt to use if multiple found
defaultEnableVirtual="true"         # Enable virtual battery (always true for this package)
defaultChainCapacity="280"          # Chain capacity in Ah (4x 70Ah batteries)
defaultInstance="514"               # D-Bus device instance
defaultProductName="Virtual Battery Chain 3"  # Product name in GUI

# Read configuration from setupOptions
readConfig() {
    # SmartShunt index (for selecting which SmartShunt if multiple found)
    if [ -f "$setupOptionsDir/smartshuntIndex" ]; then
        smartshuntIndex=$(cat "$setupOptionsDir/smartshuntIndex")
    else
        smartshuntIndex="$defaultSmartshuntIndex"
    fi

    # Enable virtual battery (should always be true for this package)
    if [ -f "$setupOptionsDir/enableVirtual" ]; then
        enableVirtual=$(cat "$setupOptionsDir/enableVirtual")
    else
        enableVirtual="$defaultEnableVirtual"
    fi

    # Chain capacity in Ah
    if [ -f "$setupOptionsDir/chainCapacity" ]; then
        chainCapacity=$(cat "$setupOptionsDir/chainCapacity")
    else
        chainCapacity="$defaultChainCapacity"
    fi

    # D-Bus device instance
    if [ -f "$setupOptionsDir/instance" ]; then
        instance=$(cat "$setupOptionsDir/instance")
    else
        instance="$defaultInstance"
    fi

    # Product name for GUI
    if [ -f "$setupOptionsDir/productName" ]; then
        productName=$(cat "$setupOptionsDir/productName")
    else
        productName="$defaultProductName"
    fi
}

# Create the virtual battery service
createVirtualBatteryService() {
    local serviceName="dbus-virtual-chain"
    local serviceDir="/data/dbus-virtual-battery/service/$serviceName"

    echo ">>> Setting up Virtual Battery service..."

    # Service dir lives under /data so it survives /service tmpfs wipes;
    # linked into /service below (same pattern as dbus-mqtt-battery chains)
    mkdir -p $serviceDir/log /var/log/$serviceName

    # Build command line arguments
    local cmdArgs=""

    # Only add smartshunt-index if it's not the default (0) to keep command cleaner
    if [ "$smartshuntIndex" != "0" ]; then
        cmdArgs="$cmdArgs --smartshunt-index $smartshuntIndex"
    fi

    # Always add instance, product-name, and capacity
    cmdArgs="$cmdArgs --instance $instance --product-name \"$productName\" --capacity $chainCapacity"

    cat > $serviceDir/run << EOF
#!/bin/sh
exec 2>&1
exec python3 /data/dbus-virtual-battery/dbus-virtual-battery.py $cmdArgs
EOF
    chmod +x $serviceDir/run

    # multilog, not svlogd - svlogd is not part of Venus OS
    cat > $serviceDir/log/run << 'EOF'
#!/bin/sh
exec 2>&1
exec multilog t s25000 n4 /var/log/dbus-virtual-chain
EOF
    chmod +x $serviceDir/log/run

    # Link into /service (replaces stale/dangling links)
    # A legacy real directory would make ln create a nested link.
    if [ -d "/service/$serviceName" ] && [ ! -L "/service/$serviceName" ]; then
        svc -dx "/service/$serviceName" "/service/$serviceName/log" 2>/dev/null || true
        mv "/service/$serviceName" "/data/dbus-virtual-battery/legacy-$serviceName.$(date +%s)"
    fi
    ln -sfn $serviceDir /service/$serviceName

    # Register with PackageManager for GUI management and auto-updates
    pmDir="/data/packageManager/dbus-virtual-battery"
    mkdir -p "$pmDir"
    [ -f "$scriptDir/gitHubInfo" ] && cp "$scriptDir/gitHubInfo" "$pmDir/"
    ln -sf "$scriptDir" "$pmDir/current"

    # Restore the volatile /service link even before PackageManager starts.
    cat > /data/dbus-virtual-battery/boot.sh <<'BOOT'
#!/bin/sh
[ -x /data/dbus-virtual-battery/service/dbus-virtual-chain/run ] || exit 0
ln -sfn /data/dbus-virtual-battery/service/dbus-virtual-chain /service/dbus-virtual-chain
BOOT
    chmod +x /data/dbus-virtual-battery/boot.sh
    python3 - <<'PYBOOT'
from pathlib import Path
path = Path('/data/rc.local')
lines = path.read_text().splitlines() if path.exists() else ['#!/bin/sh']
command = '/data/dbus-virtual-battery/boot.sh'
lines = [line for line in lines if line != command]
index = next((i for i, line in enumerate(lines) if line.strip() == 'exit 0'), len(lines))
lines.insert(index, command)
path.write_text('\n'.join(lines) + '\n')
path.chmod(path.stat().st_mode | 0o111)
PYBOOT
    echo "Created /service/$serviceName -> $serviceDir"
}

# Main execution
# SetupHelper drives this script via $scriptAction (set by IncludeHelpers);
# manual runs without an action show help
case "${scriptAction:-NONE}" in
    NONE)
        # No action - show help
        echo "dbus-virtual-battery SetupHelper script"
        echo "Usage: run via SetupHelper PackageManager, or manually:"
        echo "  scriptAction=INSTALL   $0"
        echo "  scriptAction=UNINSTALL $0"
        ;;
    INSTALL)
        readConfig

        # Check if virtual battery is enabled
        if [ "$enableVirtual" = "true" ]; then
            createVirtualBatteryService
            echo "  svstat /service/dbus-virtual-chain"
        else
            echo "Virtual battery is disabled in configuration"
        fi
        endScript
        ;;
    UNINSTALL)
        echo "Removing dbus-virtual-battery service..."
        svc -dx /service/dbus-virtual-chain /service/dbus-virtual-chain/log 2>/dev/null || true
        rm -rf /service/dbus-virtual-chain
        rm -rf /data/dbus-virtual-battery/service/dbus-virtual-chain
        # Note: We don't stop the service here as SetupHelper handles that
        endScript
        ;;
    *)
        echo "Invalid action: $scriptAction"
        exit 1
        ;;
esac
